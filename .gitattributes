* text=auto

# Source and documentation files should keep stable line endings across OSes.
*.m text eol=lf
*.md text eol=lf
*.tex text eol=lf
*.csv text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Generated/model/document binaries.
*.slx binary
*.slxc binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
